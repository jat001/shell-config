{
  "common": {},
  "environments": {
    "windows": {
      "dev_drive": {
        "vhd": "AppData/Local/Dev.vhdx"
      },
      "aliases": {
        "code": "${HOME}/scoop/apps/vscode/current/bin/code.cmd"
      }
    },
    "wsl": {
      "dev_drive": {
        "vhd": "AppData/Local/wsl/dev.vhdx",
        "mountpoint": "/mnt/wsl/dev",
        "filesystem": "btrfs",
        "options": "compress=zstd:1",
        "task": "WSL Attach Dev VHDX",
        "schtasks": "/mnt/c/Windows/System32/schtasks.exe"
      },
      "environment": {
        "PNPM_HOME": "${HOME}/.local/share/pnpm",
        "PNPM_CONFIG_CACHE_DIR": "${HOME}/.cache/pnpm",
        "PNPM_CONFIG_STATE_DIR": "${HOME}/.local/state/pnpm",
        "PNPM_CONFIG_STORE_DIR": "${PNPM_HOME}/store",
        "SSH_AUTH_SOCK": "${XDG_RUNTIME_DIR}/wsl2-ssh-agent.sock"
      },
      "path_prepend": [
        "${HOME}/.local/bin",
        "${PNPM_HOME}/bin"
      ],
      "aliases": {
        "code": "${WINDOWS_HOME}/scoop/apps/vscode/current/bin/code"
      },
      "links": {
        "${HOME}/.local/bin/git.exe": "${WINDOWS_HOME}/scoop/apps/git-without-openssh/current/cmd/git.exe"
      }
    },
    "msys2": {
      "root": "${DEV_DRIVE}/msys2",
      "path_prepend": [
        "${MSYSTEM_PREFIX}/bin",
        "/ucrt64/bin"
      ],
      "aliases": {
        "code": "${WINDOWS_HOME}/scoop/apps/vscode/current/bin/code"
      }
    }
  }
}
