{
  "common": {},
  "environments": {
    "windows": {
      "dev_drive": {
        "vhd": "AppData/Local/Dev.vhdx"
      },
      "aliases": {
        "code": "${HOME}/scoop/apps/vscode/current/bin/code.cmd"
      }
    },
    "wsl": {
      "dev_drive": {
        "vhd": "AppData/Local/wsl/dev.vhdx",
        "mountpoint": "/mnt/wsl/dev",
        "filesystem": "btrfs",
        "options": "compress=zstd:1",
        "task": "WSL Attach Dev VHDX",
        "schtasks": "/mnt/c/Windows/System32/schtasks.exe"
      },
      "user": {
        "uid": 1000,
        "gid": 1000
      },
      "ids": {
        "docker": 1001
      },
      "default_user": "root",
      "environment": {
        "XDG_CACHE_HOME": ["${DEV_DRIVE}${HOME}/.cache", "${HOME}/.cache"],
        "XDG_DATA_HOME": ["${DEV_DRIVE}${HOME}/.local/share", "${HOME}/.local/share"],
        "XDG_STATE_HOME": ["${DEV_DRIVE}${HOME}/.local/state", "${HOME}/.local/state"],
        "PNPM_HOME": "${XDG_DATA_HOME}/pnpm",
        "PNPM_CONFIG_CACHE_DIR": "${XDG_CACHE_HOME}/pnpm",
        "PNPM_CONFIG_STATE_DIR": "${XDG_STATE_HOME}/pnpm",
        "PNPM_CONFIG_STORE_DIR": "${PNPM_HOME}/store",
        "SSH_AUTH_SOCK": "${XDG_RUNTIME_DIR}/wsl2-ssh-agent.sock"
      },
      "path_prepend": [
        "${HOME}/.local/bin",
        "${PNPM_HOME}/bin"
      ],
      "aliases": {
        "code": "${WINDOWS_HOME}/scoop/apps/vscode/current/bin/code"
      },
      "links": {
        "${HOME}/.local/bin/git.exe": "${WINDOWS_HOME}/scoop/apps/git-without-openssh/current/cmd/git.exe",
        "${HOME}/.aws": "${WINDOWS_HOME}/.aws",
        "${HOME}/.azure": "${WINDOWS_HOME}/.azure",
        "${HOME}/.cargo/credentials.toml": "${WINDOWS_HOME}/scoop/apps/rustup/current/.cargo/credentials.toml",
        "${HOME}/.config/fish/fish_plugins": "${WINDOWS_HOME}/.config/fish/fish_plugins",
        "${HOME}/.config/pnpm": "${WINDOWS_HOME}/AppData/Local/pnpm/config",
        "${HOME}/.docker/contexts": "${WINDOWS_HOME}/.docker/contexts",
        "${HOME}/.docker/features.json": "${WINDOWS_HOME}/.docker/features.json",
        "${HOME}/.gitconfig": "${WINDOWS_HOME}/.gitconfig",
        "${HOME}/.gnupg": "${WINDOWS_HOME}/.gnupg",
        "${HOME}/.ssh": "${WINDOWS_HOME}/.ssh",
        "${HOME}/.vimrc": "${WINDOWS_HOME}/.vimrc",
        "${HOME}/.wakatime.cfg": "${WINDOWS_HOME}/.wakatime.cfg"
      }
    },
    "msys2": {
      "root": "${DEV_DRIVE}/msys2",
      "path_prepend": [
        "${MSYSTEM_PREFIX}/bin",
        "/ucrt64/bin"
      ],
      "aliases": {
        "code": "${WINDOWS_HOME}/scoop/apps/vscode/current/bin/code"
      }
    }
  }
}
