@{
    # These rules fire on patterns this repository uses on purpose. Keeping them enabled would
    # force per-file suppressions in almost every script.
    ExcludeRules = @(
        # Profiles and the installer intentionally keep cross-file state in $global: variables.
        'PSAvoidGlobalVars'
        # Parameters are consumed through splatting, dot-sourced test helpers or generated text.
        'PSReviewUnusedParameter'
        # Start-Job blocks receive state from their enclosing scope by design.
        'PSUseUsingScopeModifierInNewRunspaces'
        # Functions are named after the operation they perform, not the cmdlet they resemble.
        'PSUseShouldProcessForStateChangingFunctions'
        'PSUseSingularNouns'
        # Test doubles replace Get-TimeZone, Get-ItemProperty and similar cmdlets on purpose.
        'PSAvoidOverwritingBuiltInCmdlets'
        # common.ps1 evaluates the profile and completion code generated by jq and oh-my-posh.
        'PSAvoidUsingInvokeExpression'
        # The auto-logon and sandbox credentials are generated at runtime for a single test run.
        'PSAvoidUsingConvertToSecureStringWithPlainText'
        'PSAvoidUsingPlainTextForPassword'
        # -Profile is the documented user-facing parameter name on run.ps1 and hyperv.ps1.
        'PSAvoidAssignmentToAutomaticVariable'
        # The test runner prints progress to the interactive host.
        'PSAvoidUsingWriteHost'
    )
}
