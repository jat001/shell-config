# 3.14 is the newest Python the current stable ansible-core supports. requirements.txt only sets minimums.
FROM python:3.14-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssh-client openssl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements.yml /opt/ansible/

RUN --mount=type=cache,target=/root/.cache/pip \
    --mount=type=cache,target=/root/.ansible/galaxy_cache \
    pip install -r /opt/ansible/requirements.txt \
    && for attempt in 1 2 3; do \
        ansible-galaxy collection install -p /usr/share/ansible/collections \
            -r /opt/ansible/requirements.yml && break; \
        [ "$attempt" -lt 3 ] || exit 1; \
        sleep 10; \
    done

WORKDIR /work
