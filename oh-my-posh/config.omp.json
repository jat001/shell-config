{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "os": "#ACB0BE",
    "closer": "p:os",
    "pink": "#F5C2E7",
    "lavender": "#B4BEFE",
    "blue": "#89B4FA",
    "green": "#A6E3A1",
    "yellow": "#F9E2AF",
    "peach": "#FAB387",
    "red": "#F38BA8",
    "mauve": "#CBA6F7",
    "maroon": "#EBA0AC"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "plain",
          "foreground": "p:os",
          "template": "{{.Icon}} "
        },
        {
          "type": "session",
          "style": "plain",
          "foreground": "p:blue",
          "template": "{{ if .SSHSession }} {{ end }}{{ .UserName }}@{{ .HostName }} "
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:pink",
          "template": " {{ path .Path .Location }} ",
          "options": {
            "style": "folder"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:lavender",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:yellow{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:red{{ end }}",
            "{{ if gt .Ahead 0 }}p:mauve{{ end }}",
            "{{ if gt .Behind 0 }}p:maroon{{ end }}"
          ],
          "template": "{{ if .UpstreamURL }}{{ url .UpstreamIcon .UpstreamURL }} {{ end }}{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }} ",
          "options": {
            "branch_template": "{{ trunc 25 .Branch }}",
            "branch_icon": " ",
            "cherry_pick_icon": " ",
            "commit_icon": " ",
            "merge_icon": " ",
            "no_commits_icon": " ",
            "rebase_icon": " ",
            "revert_icon": " ",
            "tag_icon": " "
          }
        },
        {
          "type": "root",
          "style": "plain",
          "foreground": "p:yellow",
          "template": " "
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:green",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:red{{ end }}"
          ],
          "template": "{{ if gt .Code 0 }}{{ else }}{{ end }} ",
          "options": {
            "always_enabled": true
          }
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:closer",
          "template": ""
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "type": "node",
          "style": "plain",
          "foreground": "p:green",
          "template": " ",
          "options": {
            "display_mode": "files"
          }
        },
        {
          "type": "go",
          "style": "plain",
          "foreground": "p:blue",
          "template": " "
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "p:yellow",
          "template": " ",
          "options": {
            "display_mode": "files",
            "fetch_virtual_env": false
          }
        },
        {
          "type": "rust",
          "style": "plain",
          "foreground": "p:peach",
          "template": " ",
          "options": {
            "display_mode": "files",
            "fetch_version": false
          }
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:os",
          "template": "took <p:blue><b>{{ .FormattedMs }}</b></> ",
          "options": {
            "threshold": 100
          }
        },
        {
          "type": "shell",
          "style": "plain",
          "foreground": "p:os",
          "template": "in <p:blue><b>{{ .Name }}</b></> "
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "p:os",
          "template": "at <p:blue><b>{{ .CurrentDate | date \"15:04:05\" }}</b></>"
        }
      ]
    }
  ],
  "secondary_prompt": {
    "foreground": "p:yellow",
    "background": "transparent",
    "template": "> "
  },
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "final_space": true,
  "version": 4,
  "pwd": "osc99"
}
